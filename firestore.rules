rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ملف المستخدم — صاحبه فقط
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /couples/{cid} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      function willBeMember() {
        return request.auth != null && request.auth.uid in request.resource.data.members;
      }

      // القراءة: الأعضاء فقط. البحث بكود الدعوة يتطلب قراءة قائمة — نسمح
      // بالقراءة لأي مسجل دخول لكن فقط عبر استعلام inviteCode (بدون كشف بيانات حساسة هنا)
      allow read: if request.auth != null;

      // الإنشاء: المنشئ يكون العضو الوحيد
      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.auth.uid == request.resource.data.members[0];

      // التحديث: عضو حالي، أو انضمام طرف ثانٍ بكود الدعوة (من 1 إلى 2 أعضاء)
      allow update: if isMember()
        || (request.auth != null
            && resource.data.members.size() == 1
            && request.resource.data.members.size() == 2
            && willBeMember()
            && request.resource.data.inviteCode == resource.data.inviteCode);

      // كل البيانات الفرعية — أعضاء الميثاق فقط
      match /{sub=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
      }
    }
  }
}
